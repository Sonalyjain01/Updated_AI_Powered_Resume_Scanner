MONGO_URL="mongodb://localhost:27017"
DB_NAME="resume_scanner"
CORS_ORIGINS="http://localhost:3000"
EMERGENT_LLM_KEY=""
# Optional: LLM_PROVIDER=emergent, LLM_VENDOR=openai, LLM_MODEL=gpt-4o

# --- Scanned resumes (OCR) ---
# Needs the Tesseract program on the server. OCR_ENGINE=none turns it off.
OCR_ENGINE="tesseract"
# OCR_LANG="eng"        OCR_MAX_PAGES=5        OCR_DPI=200

# --- Virus scanning (ClamAV) ---
# Off by default. Turn it on before accepting uploads from the public.
CLAMAV_ENABLED="false"
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
# Refuse uploads while the scanner is unreachable. Set true only to accept unscanned files during an outage.
CLAMAV_FAIL_OPEN="false"

# --- Stored originals and retention ---
# STORAGE_BACKEND: local (a folder), s3 (S3 / R2 / MinIO) or none (keep nothing)
STORAGE_BACKEND="local"
STORAGE_LOCAL_DIR=""    # empty = backend/storage
FILE_RETENTION_DAYS=30
RETENTION_SWEEP_MINUTES=60
# Used when STORAGE_BACKEND=s3. Leave the keys empty to use the AWS credential chain.
S3_BUCKET=""
S3_ENDPOINT_URL=""      # e.g. http://localhost:9000 for MinIO
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- AI call limits ---
LLM_TIMEOUT_SECONDS=30
# Stop calling the AI after this many failures in a row, then try again after the cooldown
LLM_BREAKER_FAILURES=5
LLM_BREAKER_COOLDOWN_SECONDS=30
# Price per million tokens, for cost tracking. Defaults cover gpt-4o only; check your provider's price list.
# LLM_PRICE_INPUT_PER_MTOK=2.50
# LLM_PRICE_OUTPUT_PER_MTOK=10.00

# --- Monthly quotas per tenant (0 = unlimited) ---
QUOTA_SCANS_PER_MONTH=0
QUOTA_TOKENS_PER_MONTH=0
# DEFAULT_TENANT_ID=default   # used until sign-in provides a real tenant

# --- Background scans ---
# Scans are queued and analysed by workers; clients poll GET /api/v1/jobs/{id}.
JOB_WORKERS=2                    # workers in this process; 0 = run none (use a separate worker process)
JOB_MAX_PENDING_PER_TENANT=20    # queued + running scans one tenant may have at once
JOB_STALE_SECONDS=600            # a running job older than this is treated as orphaned and re-queued
JOB_MAX_ATTEMPTS=2               # starts allowed before an interrupted job is failed
JOB_RETENTION_HOURS=24           # finished jobs, with their results, are deleted after this
IDEMPOTENCY_TTL_HOURS=24         # how long an Idempotency-Key is remembered

# --- Accounts ---
# Set AUTH_REQUIRED=true for anything other than local development. While it is false, every
# request without a token runs as one shared organisation, and anyone who can reach the API can use it.
AUTH_REQUIRED=false
# At least 32 characters. Make one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""
JWT_EXPIRE_MINUTES=480
REGISTRATION_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Frontend: set REACT_APP_AUTH_ENABLED=true in frontend/.env to show the sign-in screens

# --- Personal data ---
# Scans in the default (no sign-in) organisation are deleted after this many days; 0 keeps them.
# Organisations with accounts follow their plan's retention_days instead.
SCAN_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=365
# Erasure records only matter while a backup that still holds the data exists: keep this above BACKUP_RETENTION_DAYS
TOMBSTONE_RETENTION_DAYS=90

# --- Backups ---
# python manage.py backup | restore. Copy the files off this machine: they are the only copy of the database.
# BACKUP_DIR=""                   # default backend/backups
BACKUP_ENCRYPTION_KEY=""          # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=0           # 0 = only when you run the command
